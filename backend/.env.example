# Copy to .env and adjust. All values are optional - defaults are shown.
DATABASE_URL=sqlite:///./ecoroute.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Local LLM (Ollama) - used by AI features (not implemented yet)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_ENABLED=false
# Routing: OpenStreetMap Nominatim (geocoding) and OSRM (driving routes)
GEOCODER_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org
HTTP_TIMEOUT_S=8
# Identifies the app to Nominatim (required by its usage policy). Do not put an email here.
HTTP_USER_AGENT=EcoRoute/0.1 (+https://github.com/KamilFischbach/EcoRouteFinder)
