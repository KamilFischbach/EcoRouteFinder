# Copy to .env and adjust. All values are optional - defaults are shown.
DATABASE_URL=sqlite:///./ecoroute.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Local LLM (Ollama) for the trip parser and EcoAdvisor.
# Keep AI_ENABLED=true even without Ollama: the app then runs in rule-based fallback mode.
# Set it to false to never contact Ollama at all.
AI_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Seconds per LLM call (an 8B model on CPU can be slow) and sampling temperature.
OLLAMA_TIMEOUT_S=90
OLLAMA_TEMPERATURE=0.2
# Qwen3 "thinking" mode (sent as `think` to /api/chat, Ollama >= 0.9.0). Keep it off: it is slow
# and mixes <think> text into structured output.
OLLAMA_THINK=false
# Routing: OpenStreetMap Nominatim (geocoding) and OSRM (driving routes)
GEOCODER_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org
HTTP_TIMEOUT_S=8
# Identifies the app to Nominatim (required by its usage policy). Do not put an email here.
HTTP_USER_AGENT=EcoRoute/0.1 (+https://github.com/KamilFischbach/EcoRouteFinder)
# Current weather for EcoAdvisor (Open-Meteo, no API key needed)
WEATHER_URL=https://api.open-meteo.com
